{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/whatsapp-business-api/", "destination": "/channels/whatsapp/", "permanent": true },
    { "source": "/rcs-business-messaging/", "destination": "/channels/rcs/", "permanent": true },
    { "source": "/instagram-messaging-api/", "destination": "/channels/instagram/", "permanent": true },
    { "source": "/facebook-messenger-api/", "destination": "/channels/messenger/", "permanent": true },
    { "source": "/ai-agents/voice/", "destination": "/voice-ai-agents/", "permanent": true },
    { "source": "/ai-agents/sales-sdr/", "destination": "/ai-agents/sales/", "permanent": true },
    { "source": "/ai-agents/builder/", "destination": "/ai-agents/agent-builder/", "permanent": true },
    { "source": "/about/", "destination": "/about-us/", "permanent": true },
    { "source": "/contact/", "destination": "/contact-us/", "permanent": true },
    { "source": "/partners/", "destination": "/partnerships/", "permanent": true },
    { "source": "/register/", "destination": "/signup/", "permanent": true },
    { "source": "/area-code-sitemap.xml", "destination": "/post-sitemap.xml", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" }
      ]
    },
    {
      "source": "/sitemap.xsl",
      "headers": [
        { "key": "Content-Type", "value": "text/xsl; charset=utf-8" }
      ]
    },
    {
      "source": "/404.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
