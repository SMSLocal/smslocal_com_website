      "permanent": true
    },
    {
      "source": "/area-code-sitemap.xml",
      "destination": "/post-sitemap.xml",
      "permanent": true
    },
    {
      "source": "/agentic-ai/",
      "destination": "/products/ai-agents/agentic-ai/",
      "permanent": true
    },
    {
      "source": "/ai-agents/",
      "destination": "/products/ai-agents/",
      "permanent": true
    },
    {
      "source": "/ai-agents/agent-builder/",
      "destination": "/products/ai-agents/agent-builder/",
      "permanent": true
    },
    {
      "source": "/ai-agents/booking/",
      "destination": "/products/ai-agents/booking/",
      "permanent": true
