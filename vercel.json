      "destination": "/products/channels/rcs-broadcasting/",
      "permanent": true
    },
    {
      "source": "/channels/sms-broadcasting/",
      "destination": "/products/channels/sms-broadcasting/",
      "permanent": true
    },
    {
      "source": "/channels/social/",
      "destination": "/products/social-and-apps/",
      "permanent": true
    },
    {
      "source": "/channels/telegram/",
      "destination": "/products/social-and-apps/telegram/",
      "permanent": true
    },
    {
