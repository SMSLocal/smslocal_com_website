    {
      "source": "/channels/whatsapp-broadcasting/",
      "destination": "/products/channels/whatsapp-broadcasting/",
      "permanent": true
    },
    {
      "source": "/numbers/did/",
      "destination": "/products/channels/did/",
      "permanent": true
    },
    {
      "source": "/products/agent-copilot/",
      "destination": "/products/inbox-and-analytics/agent-copilot/",
      "permanent": true
    },
    {
      "source": "/products/analytics/",
      "destination": "/products/inbox-and-analytics/analytics/",
      "permanent": true
    },
    {
      "source": "/products/omnichannel-inbox/",
      "destination": "/products/inbox-and-analytics/omnichannel-inbox/",
      "permanent": true
    },
    {
      "source": "/voice-ai-agents/",
      "destination": "/products/ai-agents/voice/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    },
    {
      "source": "/sitemap.xsl",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/xsl; charset=utf-8"
        }
      ]
    },
    {
      "source": "/404.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
