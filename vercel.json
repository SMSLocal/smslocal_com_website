{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/whatsapp-business-api/",
      "destination": "/products/channels/whatsapp/",
      "permanent": true
    },
    {
      "source": "/rcs-business-messaging/",
      "destination": "/products/channels/rcs/",
      "permanent": true
    },
    {
      "source": "/instagram-messaging-api/",
