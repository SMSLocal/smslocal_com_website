{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "functions": {
    "api/contact.js": {
      "maxDuration": 30
    },
    "api/i18n-ssr.js": {
      "maxDuration": 30,
      "includeFiles": "scripts/.cache/i18n/**"
    },
    "api/tools/carrier-lookup.js": {
      "maxDuration": 15,
      "includeFiles": "node_modules/libphonenumber-geo-carrier/resources/**"
    },
    "api/tools/send-test-sms.js": {
      "maxDuration": 30
    },
    "api/signup.js": {
      "maxDuration": 30,
      "includeFiles": "api/_lib/signup-emails/**"
    }
  },
